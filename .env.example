# Public GitHub App identifier.
GITHUB_APP_CLIENT_ID=

# Confidential GitHub App secret. Keep this on the server only.
GITHUB_APP_CLIENT_SECRET=

# Exact callback URL registered on the GitHub App.
# Optional only for local development; required as HTTPS in production.
GITHUB_CALLBACK_URL=

 # A random value of at least 32 bytes used to encrypt HTTP-only sessions.
SESSION_SECRET=
